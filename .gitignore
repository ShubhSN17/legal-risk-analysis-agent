# Virtual Environment
venv/
.venv/
env/

# Python caching
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Environment configurations containing sensitive keys
.env
.env.local

# Local Data storage 
data/contracts/*
data/policies/*

# EXCEPTION: Always track the sample files so recruiters can test the app
!data/contracts/sample_contract.pdf
!data/policies/company_playbook.txt
!data/contracts/.gitkeep
!data/policies/.gitkeep

# Never track the vector database binaries or temp files
data/chroma_db/
data/contracts/temp_*

# Mac system files
.DS_Store
