# --- LLM Provider Configuration ---
# Required: Get your free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Embedding Model Configuration (Optional) ---
# Suppresses HuggingFace unauthenticated warnings during model download
# Get your token at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# --- Tracing and Debugging (Optional) ---
# Enable to visualize LangGraph node execution in LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key_here